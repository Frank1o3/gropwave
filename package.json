{
  "name": "gropwave",
  "displayName": "GropWave",
  "description": "An agentic AI extension for using AI models Qrop hosts while you code",
  "version": "0.1.0",
  "publisher": "Frank1o3",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gropwave.focusChat",
        "title": "Focus GropWave Chat",
        "category": "GropWave"
      },
      {
        "command": "gropwave.indexWorkspace",
        "title": "Index Workspace (generate context.md)",
        "category": "GropWave"
      },
      {
        "command": "gropwave.refreshModels",
        "title": "Refresh Available Models",
        "category": "GropWave"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gropwave-sidebar",
          "title": "GropWave",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "gropwave-sidebar": [
        {
          "type": "webview",
          "id": "gropwave.chatView",
          "name": "AI Chat",
          "contextualTitle": "GropWave Assistant"
        }
      ]
    },
    "configuration": {
      "title": "GropWave",
      "properties": {
        "gropwave.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the AI provider (leave empty to use GROQ_API_KEY env var)",
          "format": "password"
        },
        "gropwave.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Custom base URL for the API endpoint (optional)"
        },
        "gropwave.defaultModel": {
          "type": "string",
          "default": "auto",
          "description": "Default model to use. 'auto' enables smart routing."
        },
        "gropwave.quotaWarningThreshold": {
          "type": "number",
          "default": 0.9,
          "minimum": 0.5,
          "maximum": 1,
          "description": "Threshold (0-1) at which to warn about quota usage"
        },
        "gropwave.contextFile": {
          "type": "string",
          "default": "context.md",
          "description": "Filename for the workspace context file"
        },
        "gropwave.systemFile": {
          "type": "string",
          "default": "system.md",
          "description": "Filename for the system instructions file"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run lint && npm run typecheck && node esbuild.js --production",
    "package": "vsce package",
    "test": "npm run build && vscode-test",
    "lint": "eslint src",
    "format": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "groq-sdk": "^1.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@vscode/vsce-sign@2.0.9": true,
    "keytar@7.9.0": true
  }
}