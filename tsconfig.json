{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": true,
		"strict": true,
		"types": [
			"node",
			"mocha"
		],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	}
}